<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>MessagingProvidersDemo.Domain</RootNamespace>
    <AssemblyName>Messaging-Providers-Demo.Domain</AssemblyName>
    <Deterministic>true</Deterministic>
    <Configurations>Debug;Release</Configurations>
    <PlatformTarget>AnyCPU</PlatformTarget>

    <!-- Redirect output to solution-level bin\dll -->
    <OutputPath>$(SolutionDir)bin\dll\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <!-- Debug / Release settings -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- Only reference system assemblies that are NOT included implicitly -->
  <ItemGroup>
    <Reference Include="System.Data.DataSetExtensions" /> <!-- if using LINQ-to-DataSet -->
    <Reference Include="System.Net.Http" />             <!-- if using HttpClient etc. -->
  </ItemGroup>

  <!-- Project references -->
  <ItemGroup>
    <ProjectReference Include="..\Helpers\Helpers.csproj" />
  </ItemGroup>

</Project>
